<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_edonusum">
        <field name="name">Türkiye E-Dönüşüm</field>
        <field name="description">E-Fatura, E-Arşiv, E-SMM ve GİB Entegrasyon Yönetimi</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_edonusum_user" model="res.groups">
        <field name="name">Kullanıcı</field>
        <field name="category_id" ref="module_category_edonusum"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_edonusum_manager" model="res.groups">
        <field name="name">Yönetici</field>
        <field name="category_id" ref="module_category_edonusum"/>
        <field name="implied_ids" eval="[(4, ref('group_edonusum_user')), (4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
