<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_edonusum" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.edonusum</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_tax_office" placeholder="Vergi Dairesi"/>
                <field name="x_is_einvoice_user" widget="boolean_toggle"/>
                <field name="x_einvoice_alias" placeholder="Örn: defaultpk" invisible="not x_is_einvoice_user"/>
                <div>
                    <button name="action_check_einvoice_taxpayer" string="GİB Mükellefiyetini Sorgula" type="object" class="btn btn-sm btn-outline-primary" icon="fa-search"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
