<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level E-Dönüşüm Menu -->
    <menuitem id="menu_edonusum_root"
              name="E-Dönüşüm"
              web_icon="e_donusum_turkiye,static/description/icon.png"
              groups="group_edonusum_user"
              sequence="45"/>

    <!-- Gelen e-Faturalar Action -->
    <record id="action_inbound_einvoices" model="ir.actions.act_window">
        <field name="name">Gelen e-Faturalar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), '|', ('x_edonusum_uuid', '!=', False), ('x_parasut_uuid', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <!-- Giden e-Faturalar Action -->
    <record id="action_outbound_einvoices" model="ir.actions.act_window">
        <field name="name">Giden e-Faturalar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('x_edonusum_profile', '!=', 'EARSIVFATURA')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <!-- e-Arşiv Faturalar Action -->
    <record id="action_outbound_earchive" model="ir.actions.act_window">
        <field name="name">e-Arşiv Faturalar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('x_edonusum_profile', '=', 'EARSIVFATURA')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_x_edonusum_profile': 'EARSIVFATURA'}</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_inbound_einvoices"
              name="Gelen e-Faturalar"
              parent="menu_edonusum_root"
              action="action_inbound_einvoices"
              sequence="10"/>

    <menuitem id="menu_outbound_einvoices"
              name="Giden e-Faturalar"
              parent="menu_edonusum_root"
              action="action_outbound_einvoices"
              sequence="20"/>

    <menuitem id="menu_outbound_earchive"
              name="e-Arşiv Faturalar"
              parent="menu_edonusum_root"
              action="action_outbound_earchive"
              sequence="30"/>

    <menuitem id="menu_edonusum_tools"
              name="İşlemler &amp; Araçlar"
              parent="menu_edonusum_root"
              sequence="50"/>

    <menuitem id="menu_action_fetch_invoices"
              name="Nilvera'dan Fatura Çek"
              parent="menu_edonusum_tools"
              action="action_fetch_invoices_wizard"
              sequence="10"/>
</odoo>
