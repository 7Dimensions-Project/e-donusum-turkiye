<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_edonusum" model="ir.ui.view">
        <field name="name">res.company.form.inherit.edonusum</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="E-Dönüşüm Türkiye" name="edonusum_config">
                    <group>
                        <group string="Entegratör Seçimi">
                            <field name="edonusum_provider" widget="radio"/>
                            <div>
                                <button name="action_test_integrator_connection" string="Seçili Entegratör Bağlantısını Test Et" type="object" class="btn-info" icon="fa-plug"/>
                            </div>
                        </group>
                        <group string="Otomasyon &amp; Yasal Ayarlar">
                            <field name="edonusum_auto_sync"/>
                            <field name="edonusum_auto_accept_days"/>
                            <field name="edonusum_last_sync_date"/>
                        </group>
                    </group>

                    <!-- Nilvera Ayarları -->
                    <group string="Nilvera API Ayarları" invisible="edonusum_provider != 'nilvera'">
                        <group>
                            <field name="nilvera_api_key" password="True" required="edonusum_provider == 'nilvera'"/>
                            <field name="nilvera_environment" widget="radio"/>
                        </group>
                    </group>

                    <!-- Paraşüt Ayarları -->
                    <group string="Paraşüt API v4 Ayarları" invisible="edonusum_provider != 'parasut'">
                        <group>
                            <field name="parasut_client_id" required="edonusum_provider == 'parasut'"/>
                            <field name="parasut_client_secret" password="True" required="edonusum_provider == 'parasut'"/>
                            <field name="parasut_company_id" required="edonusum_provider == 'parasut'"/>
                        </group>
                        <group>
                            <field name="parasut_username" placeholder="kullanici@firma.com" required="edonusum_provider == 'parasut'"/>
                            <field name="parasut_password" password="True" required="edonusum_provider == 'parasut'"/>
                        </group>
                    </group>

                    <!-- Uyumsoft Ayarları -->
                    <group string="Uyumsoft Web Servis Ayarları" invisible="edonusum_provider != 'uyumsoft'">
                        <group>
                            <field name="uyumsoft_username" required="edonusum_provider == 'uyumsoft'"/>
                            <field name="uyumsoft_password" password="True" required="edonusum_provider == 'uyumsoft'"/>
                            <field name="uyumsoft_environment" widget="radio"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
