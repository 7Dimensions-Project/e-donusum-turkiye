<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fetch_invoices_wizard_form" model="ir.ui.view">
        <field name="name">fetch.invoices.wizard.form</field>
        <field name="model">fetch.invoices.wizard</field>
        <field name="arch" type="xml">
            <form string="Nilvera Fatura Çekme Sihirbazı">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="doc_type"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>
                    <button string="Faturaları Getir" type="object" name="action_fetch_invoices" class="oe_highlight"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fetch_invoices_wizard" model="ir.actions.act_window">
        <field name="name">Nilvera'dan Fatura Çek</field>
        <field name="res_model">fetch.invoices.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
