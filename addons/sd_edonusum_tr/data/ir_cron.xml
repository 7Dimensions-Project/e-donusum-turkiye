<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Çekirdek zaten belgeleri indirir ve gönderim durumunu izler.
         Buradaki iki görev yalnızca uygulama yanıtı sürecini yönetir. -->

    <record id="cron_sd_sync_answer_status" model="ir.cron">
        <field name="name">E-Dönüşüm TR: Uygulama Yanıtı Durum Senkronizasyonu</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_sd_sync_answer_status()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_sd_auto_accept_expired" model="ir.cron">
        <field name="name">E-Dönüşüm TR: TTK m.21/2 Yasal Kabul Takibi</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_sd_auto_accept_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
