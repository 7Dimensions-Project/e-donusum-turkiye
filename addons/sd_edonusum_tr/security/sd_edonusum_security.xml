<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_sd_edonusum" model="res.groups.privilege">
        <field name="name">E-Dönüşüm TR</field>
        <field name="sequence">70</field>
    </record>

    <!-- Uygulama yanıtı verebilen kullanıcı: faturayı gören muhasebe kullanıcısı -->
    <record id="group_sd_edonusum_user" model="res.groups">
        <field name="name">Uygulama Yanıtı Verebilir</field>
        <field name="privilege_id" ref="privilege_sd_edonusum"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Entegratör bağlantısını yönetebilen: muhasebe yöneticisi -->
    <record id="group_sd_edonusum_manager" model="res.groups">
        <field name="name">Entegratör Yöneticisi</field>
        <field name="privilege_id" ref="privilege_sd_edonusum"/>
        <field name="implied_ids" eval="[(4, ref('group_sd_edonusum_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- Çok şirketli erişim: kayıtlar yalnız kullanıcının aktif şirketlerinde görünür -->
    <record id="rule_sd_edonusum_backend_company" model="ir.rule">
        <field name="name">sd.edonusum.backend: çok şirket</field>
        <field name="model_id" ref="model_sd_edonusum_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sd_edonusum_sync_log_company" model="ir.rule">
        <field name="name">sd.edonusum.sync.log: çok şirket</field>
        <field name="model_id" ref="model_sd_edonusum_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
